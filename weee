CombatSection:CreateToggle("Auto Aim", {
    Text = "Snap camera to nearest enemy",
    Default = false,
    Callback = function(v)
        if v then
            if not Connections["AutoAim"] then
                Connections["AutoAim"] = RunService.RenderStepped:Connect(function()
                    local nearest = nil
                    local nearestDist = 100 -- Max range
                    for _, plr in pairs(Players:GetPlayers()) do
                        if plr ~= Player and plr.Character and plr.Character:FindFirstChild("Head") then
                            local head = plr.Character:FindFirstChild("Head")
                            local dist = (Camera.CFrame.Position - head.Position).Magnitude
                            if dist < nearestDist then
                                nearest = head
                                nearestDist = dist
                            end
                        end
                    end
                    if nearest then
                        Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, nearest.Position)
                    end
                end)
            end
        else
            if Connections["AutoAim"] then
                Connections["AutoAim"]:Disconnect()
                Connections["AutoAim"] = nil
            end
        end
    end
})

CombatSection:CreateToggle("Infinite Stamina", {
