local UtilityTab = Tabs.Utility

local QualitySection = UtilityTab:CreateSection("Graphics Quality")

local function SetQuality(level)
    local levels = {
        [1] = { ShadowSoftness = 0.2, ShadowMaxDistance = 100, GlobalShadows = false },
        [2] = { ShadowSoftness = 0.5, ShadowMaxDistance = 200, GlobalShadows = true },
        [3] = { ShadowSoftness = 1, ShadowMaxDistance = 500, GlobalShadows = true },
    }
    local q = levels[level]
    if q then
        Lighting.ShadowSoftness = q.ShadowSoftness
        Lighting.ShadowMaxDistance = q.ShadowMaxDistance
        Lighting.GlobalShadows = q.GlobalShadows
    end
end

QualitySection:CreateDropdown("Quality Level", {
    Text = "Set global graphics quality",
    Default = "Medium",
    Values = {"Low", "Medium", "High"},
    Callback = function(v)
        local map = { Low = 1, Medium = 2, High = 3 }
        SetQuality(map[v])
    end
})

local ToolSection = UtilityTab:CreateSection("Tools")

ToolSection:CreateButton("Teleport to Spawn", {
