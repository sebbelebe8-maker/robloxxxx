local Camera = workspace.CurrentCamera

-- Safe connection handler to prevent duplicate connections
local Connections = {}
local function ConnectSignal(signal, func)
    local connection = signal:Connect(func)
    table.insert(Connections, connection)
    return connection
end

-- Disconnect all signals (used for cleanup or reset)
local function DisconnectAll()
    for _, conn in ipairs(Connections) do
        if not conn:Disabled() then
            conn:Disconnect()
        end
    end
    table.clear(Connections)
end

