local VisualSection = VisualsTab:CreateSection("Player ESP")

VisualSection:CreateToggle("Highlight Players", {
    Text = "Show colored highlights on players",
    Default = false,
    Callback = function(v)
        for _, plr in pairs(Players:GetPlayers()) do
            if plr.Character then
                local highlight = plr.Character:FindFirstChild("Highlight")
                if v then
                    if not highlight then
                        local hl = Instance.new("Highlight")
                        hl.Name = "Highlight"
                        hl.FillColor = Color3.fromRGB(0, 255, 0)
                        hl.FillTransparency = 0.5
                        hl.OutlineColor = Color3.fromRGB(0, 255, 0)
                        hl.OutlineTransparency = 0
                        hl.Parent = plr.Character
                    end
                else
                    if highlight then
                        highlight:Destroy()
                    end
                end
            end
        end
        -- Handle new players
        if v and not Connections["NewPlayerESP"] then
            Connections["NewPlayerESP"] = Players.PlayerAdded:Connect(function(plr)
                plr.CharacterAdded:Connect(function(char)
                    local hl = Instance.new("Highlight")
                    hl.Name = "Highlight"
                    hl.FillColor = Color3.fromRGB(0, 255, 0)
                    hl.FillTransparency = 0.5
                    hl.OutlineColor = Color3.fromRGB(0, 255, 0)
                    hl.OutlineTransparency = 0
                    hl.Parent = char
                end)
            end)
        elseif not v and Connections["NewPlayerESP"] then
            Connections["NewPlayerESP"]:Disconnect()
            Connections["NewPlayerESP"] = nil
        end
    end
})

