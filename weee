MovementSection:CreateToggle("Fly", {
    Text = "Enable flight (WASD + Space/Shift)",
    Default = false,
    Callback = function(v)
        if v then
            if not Connections["Fly"] then
                Connections["Fly"] = RunService.Heartbeat:Connect(function()
                    if not Character or not Humanoid then return end
                    if Humanoid.PlatformStand then
                        Humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
                    end
                    local velocity = Vector3.new()
                    local moveDir = Camera.CFrame.LookVector
                    local rightDir = Camera.CFrame.RightVector
                    local input = UserInputService:GetFocusedTextBox()
                    local keys = {}
                    if UserInputService:IsKeyDown(Enum.KeyCode.W) then keys["W"] = true end
                    if UserInputService:IsKeyDown(Enum.KeyCode.S) then keys["S"] = true end
                    if UserInputService:IsKeyDown(Enum.KeyCode.A) then keys["A"] = true end
                    if UserInputService:IsKeyDown(Enum.KeyCode.D) then keys["D"] = true end
                    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then keys["Space"] = true end
                    if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then keys["Shift"] = true end
                    
                    if keys["W"] then velocity += moveDir * 50 end
                    if keys["S"] then velocity -= moveDir * 50 end
                    if keys["A"] then velocity -= rightDir * 50 end
                    if keys["D"] then velocity += rightDir * 50 end
                    if keys["Space"] then velocity += Vector3.new(0, 50, 0) end
                    if keys["Shift"] then velocity -= Vector3.new(0, 50, 0) end
                    
                    RootPart.Velocity = velocity
                end)
            end
        else
            if Connections["Fly"] then
                Connections["Fly"]:Disconnect()
                Connections["Fly"] = nil
            end
        end
    end
})

